{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/jz97/codex-native-scorecard.schema.json",
  "title": "JZ97 Codex-native formal local scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer_role",
    "model",
    "packet_id",
    "brief_alignment",
    "originality",
    "ai_planning_innovation",
    "implementation_feasibility",
    "public_interest_inclusion",
    "risk_compliance",
    "expression_completeness",
    "weighted_total",
    "top_strengths",
    "top_deficiencies",
    "blocking_issue",
    "formal_local_evidence"
  ],
  "properties": {
    "reviewer_role": {
      "type": "string",
      "enum": ["PRIMARY", "CHALLENGER", "HOLDOUT"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "brief_alignment": { "$ref": "#/$defs/integer_band" },
    "originality": { "$ref": "#/$defs/integer_band" },
    "ai_planning_innovation": { "$ref": "#/$defs/integer_band" },
    "implementation_feasibility": { "$ref": "#/$defs/integer_band" },
    "public_interest_inclusion": { "$ref": "#/$defs/integer_band" },
    "risk_compliance": { "$ref": "#/$defs/integer_band" },
    "expression_completeness": { "$ref": "#/$defs/integer_band" },
    "weighted_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "top_strengths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 800 }
    },
    "top_deficiencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 800 }
    },
    "blocking_issue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "formal_local_evidence": {
      "type": "boolean",
      "const": true
    }
  },
  "$defs": {
    "integer_band": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  }
}
